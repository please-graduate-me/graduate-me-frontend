{
  "name": "@graduate-me/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mascot:scene": "node design/boo-rive/build-scene.mjs",
    "mascot:runtime": "node design/boo-rive/copy-runtime.mjs",
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build --watch",
    "build": "pnpm typecheck && vite build",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "test": "pnpm routes:generate && vitest run",
    "test:watch": "pnpm routes:generate && vitest",
    "dev:app": "vite --host 0.0.0.0",
    "dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
    "dev:logs": "docker compose logs --follow --tail=50",
    "check:ci": "pnpm format:check && pnpm lint && pnpm typecheck",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@rive-app/react-canvas": "4.39.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/dynamic": "^2.1.5",
    "pdfjs-dist": "^6.5.438",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.18",
    "vite": "^8.3.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "@vanilla-extract/vite-plugin": "^5.2.6"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
