{
  "name": "@graduate-me/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build --watch",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:app": "next dev --webpack --hostname 0.0.0.0",
    "dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down",
    "dev:logs": "docker compose logs --follow --tail=50"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.3",
    "next": "16.4.3",
    "pdfjs-dist": "^6.5.438",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vanilla-extract/next-plugin": "^2.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
